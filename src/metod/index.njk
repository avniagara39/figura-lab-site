---
layout: base.njk
bodyClass: editorial-page page--method
title: Метод
description: "Метод Figura Lab — целостный подход к благополучию: тело, привычки, мышление и качество жизни без крайностей и временных решений."
crumb: "Метод"
---

{# =====================================================================
   /metod/ — Метод и философия работы
   Контент: src/_data/pages.json → pages.metod (+ home.process для этапов)
   CONFLICT-03 RESOLVED: формулировки гендерно нейтральны.
   ===================================================================== #}

{% set heroVariant = 'method' %}
{% set heroResting = true %}
{% set pageTitle = pages.metod.title %}
{% set eyebrow = pages.metod.eyebrow %}
{% set pageIntro = pages.metod.intro %}
{% set heroSymbol = home.method.symbol.src %}
{% set heroSymbolAlt = home.method.symbol.alt %}
{% set heroPrimary = { label: "Записаться на консультацию", url: "/kontakty/" } %}
{% set heroSecondary = { label: "Все программы", url: "/programmy/" } %}

{% include "components/breadcrumbs.njk" %}
{% include "components/page-hero.njk" %}

{# --- Философия -------------------------------------------------------- #}
<section class="internal-section chapter chapter--light scene scene--pearl scene--shell scene--sweep method-philosophy" aria-labelledby="philosophy-title">
  <div class="container">
    <div class="method-block__inner">

      <div class="reveal reveal--rise">
        <h2 class="method-block__title" id="philosophy-title">{{ pages.metod.philosophyHeading }}</h2>
        <p class="statement method-block__statement">{{ home.method.statement }}</p>
        <div class="method-block__body">
          {% for p in pages.metod.philosophy %}<p>{{ p }}</p>{% endfor %}
        </div>
      </div>

      <div class="reveal reveal--delay-1">
        <figure class="editorial-media">
          <img src="/assets/img/editorial/abstract/abstract-05-900.jpg"
               alt="{{ home.immersive.image.alt }}"
               width="900" height="600" loading="lazy" decoding="async">
        </figure>
        <p class="hand-note method-block__note">{{ home.method.note }}</p>
      </div>

    </div>
  </div>
</section>

{# --- Принципы --------------------------------------------------------- #}
<section class="internal-section chapter" aria-labelledby="principles-title">
  <div class="container">
    <div class="chapter-head reveal">
      <h2 class="chapter-head__title" id="principles-title">{{ pages.metod.principlesHeading }}</h2>
    </div>

    <ol class="numbered-list numbered-list--2" role="list">
      {% for item in pages.metod.principles %}
      <li class="numbered-list__item reveal reveal--delay-{{ loop.index0 % 3 + 1 }}">
        <span class="numbered-list__num" aria-hidden="true">{{ item.num }}</span>
        <h3 class="numbered-list__title">{{ item.title }}</h3>
        <p class="numbered-list__text">{{ item.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# --- Этапы работы (те же этапы, что и на главной) --------------------- #}
<section class="internal-section chapter chapter--sand scene scene--linen scene--shell scene--shell-reverse" aria-labelledby="stages-title">
  <div class="container">
    <div class="process__inner">

      <div class="process__aside reveal">
        <h2 class="process__title" id="stages-title">{{ pages.metod.stagesHeading }}</h2>
        <p class="process__lead lead">{{ pages.metod.stagesLead }}</p>
        <a href="/programmy/" class="btn btn-soft">
          Все программы <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="process__stages" role="list" data-process-stages>
        {% for stage in home.process.stages %}
        <li class="process__stage" data-process-stage>
          <span class="process__num" aria-hidden="true">{{ stage.num }}</span>
          <div>
            <h3 class="process__stage-title">{{ stage.title }}</h3>
            <p class="process__stage-text">{{ stage.text }}</p>
          </div>
        </li>
        {% endfor %}
      </ol>

    </div>
  </div>
</section>

{# --- Границы метода ---------------------------------------------------
   Честные ограничения без медицинских обещаний.
   LEGAL_REVIEW: итоговые формулировки проверяются юристом (см. docs). #}
<section class="internal-section chapter chapter--light" aria-labelledby="limits-title">
  <div class="container">
    <div class="chapter-head reveal">
      <h2 class="chapter-head__title" id="limits-title">{{ pages.metod.limitsHeading }}</h2>
    </div>
    <div class="prose reveal">
      <ul role="list">
        {% for line in pages.metod.limits %}<li>{{ line }}</li>{% endfor %}
      </ul>
      <p>{{ pages.metod.legalNote }}</p>
    </div>
  </div>
</section>

{% include "components/cta-block.njk" %}
