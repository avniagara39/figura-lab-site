{# =====================================================================
   /privacy/ — Правовой документ
   Контент: src/_data/pages.json → pages.legal.privacy
   LEGAL_REVIEW: полный текст политики пишется и проверяется юристом.
   Реквизиты оператора ПДн публикуются после подтверждения (V-09).
   Публично показываем только фактические, проверяемые утверждения.
   ===================================================================== #}

{% set doc = pages.legal.privacy %}
{% set pageTitle = doc.title %}
{% set eyebrow = doc.eyebrow %}
{% set pageIntro = doc.intro %}

{% include "components/breadcrumbs.njk" %}
{% include "components/page-hero.njk" %}

<section class="chapter chapter--light chapter--arc" aria-labelledby="legal-facts-title">
  <div class="container">

    <div class="info-panel reveal">
      <p class="info-panel__title">{{ doc.pendingTitle }}</p>
      <p>{{ doc.pendingNote }}</p>
    </div>

    <div class="prose reveal">
      <h2 id="legal-facts-title">{{ doc.factsHeading }}</h2>
      <ul role="list">
        {% for line in doc.facts %}<li>{{ line }}</li>{% endfor %}
      </ul>

      <h2>{{ doc.contactHeading }}</h2>
      <p>
        {{ doc.contactNote }}
        {% if contact.email.enabled %}
        <a href="{{ contact.email.url }}">{{ contact.email.label }}</a>
        {% endif %}
      </p>
    </div>

  </div>
</section>
