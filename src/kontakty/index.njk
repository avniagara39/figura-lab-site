---
layout: base.njk
title: Контакты
description: "Записаться на консультацию к Елене Бастуевой — Figura Lab. Телефон, почта и подтверждённые каналы связи."
crumb: "Контакты"
---

{# =====================================================================
   /kontakty/ — Консультация и каналы связи
   Контент: src/_data/pages.json → pages.kontakty, src/_data/contact.json
   Форма записи включается флагом features.contactForm.liveEndpoint,
   когда будет подключён реальный приём заявок (V-08). Пока — прямая связь,
   чтобы на странице не было нерабочих кнопок.
   Медицинские данные через сайт не собираются.
   ===================================================================== #}

{% from "components/channels.njk" import channelChips, directContacts %}
{% set liveMessengers = contact.messengers | selectattr("enabled") | selectattr("url") %}

{% set pageTitle = pages.kontakty.title %}
{% set eyebrow = pages.kontakty.eyebrow %}
{% set pageIntro = pages.kontakty.intro %}
{% set heroSymbol = home.audience.items[2].symbol %}
{% set heroSymbolAlt = home.audience.items[2].symbolAlt %}

{% include "components/breadcrumbs.njk" %}
{% include "components/page-hero.njk" %}

{# --- Прямая связь + что происходит на консультации -------------------- #}
<section class="chapter chapter--light chapter--arc" aria-labelledby="contact-direct-title">
  <div class="container">
    <div class="contact-layout">

      <div class="contact-card reveal">
        <h2 class="contact-card__title" id="contact-direct-title">{{ pages.kontakty.directHeading }}</h2>
        <p class="contact-card__text">{{ pages.kontakty.directNote }}</p>

        {{ directContacts(contact) }}

        {% if liveMessengers | length %}
        <p class="contact-card__label">Мессенджеры</p>
        {{ channelChips(contact.messengers) }}
        {% endif %}

        {% if contact.addressEnabled and contact.address %}
        <p class="contact-card__label">Адрес</p>
        <p class="contact-card__text">{{ contact.address }}</p>
        {% endif %}

        {% if not features.contactForm.liveEndpoint %}
        <p class="contact-card__label">{{ pages.kontakty.formPendingTitle }}</p>
        <p class="contact-card__text">{{ pages.kontakty.formPendingNote }}</p>
        {% endif %}

        <p class="contact-card__note">{{ pages.kontakty.privacyNote }}</p>
      </div>

      <div class="reveal reveal--delay-1">
        <h2 class="chapter-head__title contact-expect__title" id="contact-expect-title">{{ pages.kontakty.expectHeading }}</h2>
        <ol class="numbered-list" role="list">
          {% for step in pages.kontakty.expect %}
          <li class="numbered-list__item">
            <span class="numbered-list__num" aria-hidden="true">0{{ loop.index }}</span>
            <p class="numbered-list__text">{{ step }}</p>
          </li>
          {% endfor %}
        </ol>
      </div>

    </div>
  </div>
</section>

{# --- Форма записи (активируется флагом) -------------------------------
   Пока приём заявок не подключён, вместо нерабочей формы показываем
   ответы на частые вопросы — те же, что на странице программ. #}
<section class="chapter chapter--sand chapter--arc" aria-labelledby="contact-form-title">
  <div class="container">

    {% if features.contactForm.liveEndpoint %}
    <div class="chapter-head reveal">
      <h2 class="chapter-head__title" id="contact-form-title">{{ pages.kontakty.formHeading }}</h2>
    </div>
    <p class="measure-narrow reveal">{{ pages.kontakty.formNote }}</p>

    {# Собираем только имя и способ связи. Медицинские данные не запрашиваем. #}
    <form class="form reveal" action="{{ features.contactForm.endpoint }}" method="post"
          aria-labelledby="contact-form-title">
      <div class="form__field">
        <label class="form__label" for="contact-name">
          Ваше имя <span class="form__req" aria-hidden="true">*</span>
        </label>
        <input class="form__input" type="text" id="contact-name" name="name"
               autocomplete="name" required>
      </div>

      <div class="form__field">
        <label class="form__label" for="contact-link">
          Телефон или почта <span class="form__req" aria-hidden="true">*</span>
        </label>
        <input class="form__input" type="text" id="contact-link" name="contact"
               autocomplete="tel" required>
        <p class="form__hint">Укажите удобный способ связи — так, как вам комфортнее.</p>
      </div>

      <div class="form__field">
        <label class="form__label" for="contact-goal">Коротко о запросе</label>
        <textarea class="form__textarea" id="contact-goal" name="goal" rows="4"
                  placeholder="Что хотите изменить? Или просто — хочу узнать больше."></textarea>
        <p class="form__hint">Не указывайте медицинские данные — это обсуждается лично на консультации.</p>
      </div>

      <label class="form__consent" for="contact-consent">
        <input class="form__checkbox" type="checkbox" id="contact-consent" name="consent" required>
        <span class="form__consent-text">
          Я даю <a href="/consent/">согласие на обработку персональных данных</a>
          в соответствии с <a href="/privacy/">политикой конфиденциальности</a>.
        </span>
      </label>

      <button type="submit" class="btn btn-primary btn-lg">
        Записаться на консультацию <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
    </form>

    {% else %}
    <div class="chapter-head reveal">
      <h2 class="chapter-head__title" id="contact-form-title">{{ pages.programmy.faqHeading }}</h2>
    </div>
    <div class="faq reveal">
      {% for item in pages.programmy.faq %}
      <details class="faq__item">
        <summary>{{ item.q }}</summary>
        <div class="faq__body"><p>{{ item.a }}</p></div>
      </details>
      {% endfor %}
    </div>
    {% endif %}

  </div>
</section>
