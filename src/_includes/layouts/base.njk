<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.fullName }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="{{ site.themeColor }}">

  {# Preload critical fonts #}
  <link rel="preload" href="/assets/fonts/manrope-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/cormorant-400-latin.woff2" as="font" type="font/woff2" crossorigin>

  {# LCP image preload — only on homepage with hero #}
  {% if preloadHero %}
  <link rel="preload" as="image"
    href="/assets/img/elena/elena-hero-800.webp"
    imagesrcset="/assets/img/elena/elena-hero-400.webp 400w, /assets/img/elena/elena-hero-800.webp 800w, /assets/img/elena/elena-hero-1040.webp 1040w"
    imagesizes="(max-width: 900px) 90vw, 520px"
    fetchpriority="high">
  {% endif %}

  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  {# Skip link — first focusable element #}
  {% include "components/skip-link.njk" %}

  {# Site header #}
  {% include "components/header.njk" %}

  {# Page content #}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  {# Site footer #}
  {% include "components/footer.njk" %}

  <script src="/assets/js/site.js"></script>
</body>
</html>
