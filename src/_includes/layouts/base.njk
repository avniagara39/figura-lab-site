<!DOCTYPE html>
<html lang="{{ site.lang }}"{% if features.signatureMotion %} class="signature-motion"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.fullName }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="{{ site.themeColor }}">

  {# Open Graph — og:url/canonical выводятся после выбора домена (VERIFY_WITH_ELENA V-02) #}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.fullName }}">
  <meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.fullName }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">

  {# Иконки сайта — квадратные производные утверждённого знака #}
  <link rel="icon" href="/assets/img/brand/figura-icon-64.png" sizes="64x64" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/brand/figura-icon-180.png">

  {# Critical fonts #}
  <link rel="preload" href="/assets/fonts/cormorant-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/manrope-var-cyrillic.woff2" as="font" type="font/woff2" crossorigin>

  {# LCP portrait — homepage hero only #}
  {% if preloadHero %}
  <link rel="preload" as="image"
    href="/assets/img/elena/elena-portrait-760.jpg"
    imagesrcset="/assets/img/elena/elena-portrait-520.jpg 520w, /assets/img/elena/elena-portrait-760.jpg 760w, /assets/img/elena/elena-portrait-1040.jpg 1040w"
    imagesizes="(max-width: 56rem) 26rem, 30rem"
    fetchpriority="high">
  {% endif %}

  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  {% include "components/skip-link.njk" %}
  {% include "components/header.njk" %}

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "components/footer.njk" %}

  <script src="/assets/js/site.js"></script>
</body>
</html>
