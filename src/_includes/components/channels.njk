{#
  Каналы связи — единая точка рендера.
  Источник данных: src/_data/contact.json
  Канал с enabled=false НЕ выводится (никаких мёртвых публичных ссылок).
  Использование:
    {% from "components/channels.njk" import channelChips, directContacts %}
    {% set liveMessengers = contact.messengers | selectattr("enabled") | selectattr("url") %}
#}

{#- Чипы-ссылки на внешние каналы (мессенджеры / соцсети) -#}
{%- macro channelChips(items) -%}
  {%- set visible = items | selectattr("enabled") | selectattr("url") -%}
  {%- if visible | length -%}
  <ul class="channel-list" role="list">
    {%- for c in visible %}
    <li>
      <a href="{{ c.url }}" class="channel-link" target="_blank" rel="noopener noreferrer"
         aria-label="{{ c.ariaLabel }}">
        <span class="channel-link__dot" aria-hidden="true"></span>{{ c.label }}
      </a>
    </li>
    {%- endfor %}
  </ul>
  {%- endif -%}
{%- endmacro -%}

{#- Прямые контакты: телефон и email. Работают как fallback, пока мессенджеры не подтверждены. -#}
{%- macro directContacts(contact) -%}
<ul class="channel-list" role="list">
  {%- if contact.phone.enabled %}
  <li>
    <a href="{{ contact.phone.url }}" class="channel-link" aria-label="{{ contact.phone.ariaLabel }}">
      <span class="channel-link__dot" aria-hidden="true"></span>{{ contact.phone.label }}
    </a>
  </li>
  {%- endif %}
  {%- if contact.phoneMobile.enabled %}
  <li>
    <a href="{{ contact.phoneMobile.url }}" class="channel-link" aria-label="{{ contact.phoneMobile.ariaLabel }}">
      <span class="channel-link__dot" aria-hidden="true"></span>{{ contact.phoneMobile.label }}
    </a>
  </li>
  {%- endif %}
  {%- if contact.email.enabled %}
  <li>
    <a href="{{ contact.email.url }}" class="channel-link" aria-label="{{ contact.email.ariaLabel }}">
      <span class="channel-link__dot" aria-hidden="true"></span>{{ contact.email.label }}
    </a>
  </li>
  {%- endif %}
</ul>
{%- endmacro -%}
