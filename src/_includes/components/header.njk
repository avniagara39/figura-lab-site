<header class="site-header" role="banner">
  <div class="site-header__inner">

    {# Compact brand lockup: approved logo mark + readable HTML wordmark.
       Логотип не переработан — используется только утверждённый знак. #}
    <a href="/" class="brand-link" aria-label="{{ site.fullName }} — на главную">
      <img
        src="{{ site.brand.mark }}"
        alt=""
        class="brand-link__mark"
        width="218"
        height="321"
        fetchpriority="high"
        decoding="sync">
      <span class="brand-link__text">
        <span class="brand-link__name">{{ site.brand.nameLatin }}</span>
        <span class="brand-link__by">{{ site.brand.by }}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Открыть меню навигации">
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Основная навигация">
      <ul class="nav-list" role="list">
        {% for item in nav %}
        <li>
          <a
            href="{{ item.url }}"
            class="nav-link"
            {% if page.url | isActive(item.url) %}aria-current="page"{% endif %}>
            {{ item.label }}
          </a>
        </li>
        {% endfor %}
      </ul>

      <a href="{{ site.consultationCta.url }}" class="nav-cta" aria-label="{{ site.consultationCta.full }}">
        <span class="nav-cta__short">{{ site.consultationCta.short }}</span>
        <span class="nav-cta__long">{{ site.consultationCta.full }}</span>
      </a>
    </nav>

  </div>
</header>
