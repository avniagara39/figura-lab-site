<header class="site-header" role="banner">
  <div class="site-header__inner container">

    {# ── Wordmark — BRAND_ASSET_PENDING_FINAL
       Заменить <span> на <img src="/assets/img/logo.svg"> когда лого утверждён #}
    <a href="/" class="brand-link" aria-label="{{ site.name }} — На главную">
      <span class="brand-mark__name">Figura Lab</span>
      <span class="brand-mark__by">by Елена Бастуева</span>
    </a>

    {# ── Burger (mobile only) #}
    <button
      class="nav-toggle"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Открыть меню навигации">
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    {# ── Main navigation #}
    <nav id="site-nav" class="site-nav" aria-label="Основная навигация">

      <ul class="nav-list" role="list">
        {% for item in nav %}
        <li class="nav-list__item">
          <a
            href="{{ item.url }}"
            class="nav-link"
            {% if page.url | isActive(item.url) %}aria-current="page"{% endif %}>
            {{ item.label }}
          </a>
        </li>
        {% endfor %}
      </ul>

      <a href="/kontakty/" class="nav-cta" aria-label="Записаться на консультацию">
        Консультация
      </a>

    </nav>

  </div>
</header>
