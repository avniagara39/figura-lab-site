{% from "components/channels.njk" import channelChips, directContacts %}
{% set liveMessengers = contact.messengers | selectattr("enabled") | selectattr("url") %}
{% set liveSocials = contact.socials | selectattr("enabled") | selectattr("url") %}

<footer class="site-footer" role="contentinfo">
  <div class="container">

    <div class="footer-grid">

      <div class="footer-col">
        <a href="/" class="footer-brand" aria-label="{{ site.fullName }} — на главную">
          <img src="{{ site.brand.mark }}" alt="" class="footer-brand__mark" width="218" height="321" loading="lazy" decoding="async">
          <span class="footer-brand__text">
            <span class="footer-brand__name">{{ site.brand.nameLatin }}</span>
            <span class="footer-brand__by">{{ site.brand.by }}</span>
          </span>
        </a>
        <p class="footer-tagline">
          Осознанный путь к устойчивому благополучию: гармония тела, энергии и образа жизни — без крайностей и временных решений.
        </p>
      </div>

      <nav class="footer-col" aria-label="Разделы сайта">
        <h2 class="footer-col__heading">Разделы</h2>
        <ul class="footer-list" role="list">
          {% for item in nav %}
          <li><a href="{{ item.url }}" class="footer-list__link">{{ item.label }}</a></li>
          {% endfor %}
          <li><a href="/kontakty/" class="footer-list__link">Контакты</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-col__heading">Консультация</h2>
        <ul class="footer-list" role="list">
          <li><a href="{{ site.consultationCta.url }}" class="footer-list__link">{{ site.consultationCta.full }}</a></li>
          <li><a href="/programmy/#faq" class="footer-list__link">Вопросы и ответы</a></li>
          {% if contact.phone.enabled %}
          <li><a href="{{ contact.phone.url }}" class="footer-list__link">{{ contact.phone.label }}</a></li>
          {% endif %}
          {% if contact.email.enabled %}
          <li><a href="{{ contact.email.url }}" class="footer-list__link">{{ contact.email.label }}</a></li>
          {% endif %}
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-col__heading">Связь</h2>
        <div class="footer-channels">
          {% if liveMessengers | length %}
          <div>
            <p class="footer-channels__group-label">Мессенджеры</p>
            {{ channelChips(contact.messengers) }}
          </div>
          {% endif %}
          {% if liveSocials | length %}
          <div>
            <p class="footer-channels__group-label">Социальные сети</p>
            {{ channelChips(contact.socials) }}
          </div>
          {% endif %}
          {% if not (liveMessengers | length) and not (liveSocials | length) %}
          {# VERIFY_WITH_ELENA (V-03): Telegram / MAX / WhatsApp / VK / Instagram — ссылки не подтверждены,
             поэтому каналы не публикуются. Включаются в src/_data/contact.json через enabled: true. #}
          <p class="footer-list__text">Telegram, MAX, WhatsApp, VK и Instagram появятся здесь, как только каналы будут открыты.</p>
          {% endif %}
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <div class="footer-legal">
        <a href="/privacy/" class="footer-legal__link">Политика конфиденциальности</a>
        <a href="/consent/" class="footer-legal__link">Согласие на обработку данных</a>
      </div>
      <p class="footer-copy">
        &copy; {% year %} {{ site.fullName }}.
        {# Реквизиты оператора ПДн: VERIFY_WITH_ELENA (V-11) + LEGAL_REVIEW #}
        <span class="footer-copy__note">Сайт носит информационный характер и не является публичной офертой.</span>
      </p>
    </div>

  </div>
</footer>
