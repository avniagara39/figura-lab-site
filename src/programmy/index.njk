---
layout: base.njk
title: Программы
description: "Программы Figura Lab — три формата работы с Еленой Бастуевой. Подходящий вариант выбирается на консультации."
crumb: "Программы"
---

{# =====================================================================
   /programmy/ — Программы
   Контент: src/_data/pages.json → pages.programmy, home.programs.items
   Цены, длительность и состав НЕ публикуются до подтверждения Еленой.
   ===================================================================== #}

{% set pageTitle = pages.programmy.title %}
{% set eyebrow = pages.programmy.eyebrow %}
{% set pageIntro = pages.programmy.intro %}
{% set heroPrimary = { label: "Записаться на консультацию", url: "/kontakty/" } %}
{% set heroSecondary = { label: "Узнать о методе", url: "/metod/" } %}

{% include "components/breadcrumbs.njk" %}
{% include "components/page-hero.njk" %}

{# --- Программы -------------------------------------------------------- #}
<section class="chapter chapter--light chapter--arc" aria-labelledby="programs-list-title">
  <div class="container">
    <h2 class="visually-hidden" id="programs-list-title">Список программ</h2>

    <div class="programs-page">
      {% for prog in home.programs.items %}
      <article class="program-detail reveal" id="{{ prog.url | replace('/programmy/#', '') }}"
               aria-labelledby="program-{{ loop.index }}">
        <div class="program-detail__inner">

          <figure class="program-detail__figure">
            <img src="{{ prog.image }}" alt=""
                 width="900" height="600" loading="lazy" decoding="async"
                 class="program-panel__img--{{ loop.index }}">
          </figure>

          <div>
            <h3 class="program-detail__title" id="program-{{ loop.index }}">{{ prog.name }}</h3>
            <p class="program-detail__summary">{{ prog.summary }}</p>

            <dl class="spec-list">
              <div class="spec-list__row">
                <dt class="spec-list__label">Для кого</dt>
                <dd class="spec-list__value">{{ prog.audience }}</dd>
              </div>
              <div class="spec-list__row">
                <dt class="spec-list__label">Что входит</dt>
                <dd class="spec-list__value">{{ prog.includes }}</dd>
              </div>
              <div class="spec-list__row">
                <dt class="spec-list__label">Формат</dt>
                <dd class="spec-list__value">{{ prog.format }}</dd>
              </div>
            </dl>

            <a href="/kontakty/" class="btn btn-primary">
              Записаться на консультацию <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# --- О составе и условиях --------------------------------------------- #}
<section class="chapter chapter--sand chapter--arc" aria-labelledby="programs-details-title">
  <div class="container">
    <div class="info-panel reveal">
      <h2 class="info-panel__title" id="programs-details-title">{{ pages.programmy.detailsHeading }}</h2>
      <p>{{ pages.programmy.detailsNote }}</p>
    </div>
  </div>
</section>

{# --- FAQ -------------------------------------------------------------- #}
<section class="chapter chapter--light chapter--arc" id="faq" aria-labelledby="programs-faq-title">
  <div class="container">
    <div class="chapter-head reveal">
      <h2 class="chapter-head__title" id="programs-faq-title">{{ pages.programmy.faqHeading }}</h2>
    </div>

    <div class="faq reveal">
      {% for item in pages.programmy.faq %}
      <details class="faq__item">
        <summary>{{ item.q }}</summary>
        <div class="faq__body"><p>{{ item.a }}</p></div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{% include "components/cta-block.njk" %}
