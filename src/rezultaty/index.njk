---
layout: base.njk
title: Результаты
description: "Результаты и истории клиентов Figura Lab — реальный опыт, публикуемый только с письменного согласия."
crumb: "Результаты"
---

{# =====================================================================
   /rezultaty/ — Результаты и истории
   Контент: src/_data/pages.json → pages.rezultaty, home.results
   Реальные истории появляются при features.stories.published = true
   и заполненном home.results.items. Ничего не выдумывать.
   ===================================================================== #}

{% set pageTitle = pages.rezultaty.title %}
{% set eyebrow = pages.rezultaty.eyebrow %}
{% set pageIntro = pages.rezultaty.intro %}
{% set heroSymbol = home.audience.items[3].symbol %}
{% set heroSymbolAlt = home.audience.items[3].symbolAlt %}
{% set heroPrimary = { label: "Записаться на консультацию", url: "/kontakty/" } %}

{% include "components/breadcrumbs.njk" %}
{% include "components/page-hero.njk" %}

{# --- Истории --------------------------------------------------------- #}
<section class="chapter chapter--light chapter--arc" aria-labelledby="stories-title">
  <div class="container">

    <div class="chapter-head reveal">
      <h2 class="chapter-head__title" id="stories-title">
        {% if features.stories.published and home.results.items | length %}Истории{% else %}{{ pages.rezultaty.themesHeading }}{% endif %}
      </h2>
    </div>

    <div class="stories-grid">
      {% if features.stories.published and home.results.items | length %}
        {% for story in home.results.items %}
        <article class="story-card reveal reveal--delay-{{ loop.index0 % 3 + 1 }}">
          <span class="story-card__mark" aria-hidden="true">«</span>
          <h3 class="story-card__theme">{{ story.theme }}</h3>
          <p class="story-card__text">{{ story.excerpt }}</p>
          <div class="story-card__foot">
            <a href="{{ story.url }}" class="editorial-link editorial-link--sm">
              Читать историю <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
        {% endfor %}
      {% else %}
        {% for theme in home.results.themes %}
        <article class="story-card reveal reveal--delay-{{ loop.index0 % 3 + 1 }}">
          <span class="story-card__mark" aria-hidden="true">«</span>
          <h3 class="story-card__theme">{{ theme.theme }}</h3>
          <p class="story-card__text">{{ theme.text }}</p>
          <div class="story-card__foot">
            <span class="pending-line">Готовится к публикации</span>
          </div>
        </article>
        {% endfor %}
      {% endif %}
    </div>

    {% if not features.stories.published %}
    <div class="info-panel stories-note reveal">
      <p class="info-panel__title">{{ pages.rezultaty.pendingTitle }}</p>
      <p>{{ pages.rezultaty.pendingNote }}</p>
    </div>
    {% endif %}

  </div>
</section>

{# --- Как мы публикуем истории ----------------------------------------- #}
<section class="chapter chapter--sand chapter--arc" aria-labelledby="stories-how-title">
  <div class="container">
    <div class="chapter-head reveal">
      <h2 class="chapter-head__title" id="stories-how-title">{{ pages.rezultaty.howHeading }}</h2>
    </div>
    <div class="prose reveal">
      {% for p in pages.rezultaty.how %}<p>{{ p }}</p>{% endfor %}
    </div>
  </div>
</section>

{% include "components/cta-block.njk" %}
